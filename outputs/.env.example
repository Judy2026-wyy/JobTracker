# 复制为 .env 并填入真实值（.env 不要提交到版本库）

# 大模型 API Key（用于截图识别 + 邮件正文解析），当前实现调用 OpenAI
LLM_API_KEY="sk-..."
# 如使用自建/第三方 OpenAI 兼容网关，取消注释并填写
LLM_BASE_URL="https://api.openai.com/v1"

# 截图识别 / 邮件解析使用的模型（不设置则默认 gpt-4o）
VISION_MODEL=gpt-4o
TEXT_MODEL=gpt-4o

# 163 邮箱 IMAP 凭据
IMAP_HOST=imap.163.com
IMAP_USER=your_email@163.com
IMAP_PASS="your_imap_auth_code"

# 可选：数据库文件路径，默认 job_tracker.db（当前目录）
JOB_TRACKER_DB_PATH=job_tracker.db
